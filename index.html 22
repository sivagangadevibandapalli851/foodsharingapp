<h2>Test - Share Food</h2>
<input id="n" placeholder="Dish Name">
<input id="l" placeholder="Location">
<button onclick="add()">Share Now</button>
<div id="list"></div>
<script>
function add(){
  var name=document.getElementById('n').value;
  var loc=document.getElementById('l').value;
  if(!name||!loc){alert('Name & Location pettu');return;}
  document.getElementById('list').innerHTML += '<p>🍛 '+name+' - 📍 '+loc+'</p>';
  alert('Added! '+name);
}
</script>
