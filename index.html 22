<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Anna Daatha - Unlimited</title><style>body{font-family:Arial;background:#fff8e7;margin:0}header{background:#ff6f00;color:#fff;padding:16px;text-align:center;font-size:20px;font-weight:bold}.box{max-width:500px;margin:auto;padding:15px}.card{background:#fff;padding:15px;border-radius:10px;box-shadow:0 2px 6px rgba(0,0,0,.15);margin-bottom:12px}input,textarea{width:100%;padding:11px;margin:6px 0;border:1px solid #ccc;border-radius:8px;box-sizing:border-box}button{width:100%;padding:12px;border:0;border-radius:8px;font-weight:bold;cursor:pointer}.orange{background:#ff6f00;color:#fff}.green{background:#2e7d32;color:#fff;margin-top:6px}</style></head><body><header>🍱 Anna Daatha<br><small>Unlimited Dishes - Any Location</small></header><div class="box"><div class="card"><h3>Add Dish</h3><input id="a" placeholder="Dish Name *"><input id="b" placeholder="Location *"><input id="c" placeholder="Quantity"><input id="d" placeholder="Contact"><button class="orange" onclick="addFood()">Share Food Now</button><p id="m" style="text-align:center;font-weight:bold"></p></div><h3>Foods - <span id="cnt">0</span> Dishes</h3><div id="list"></div></div><script>let f=JSON.parse(localStorage.getItem('anna')||'[]');function show(){document.getElementById('cnt').innerText=f.length;let h=f.length?'':'<p>No foods yet, add first dish!</p>';f.forEach(x=>{h+=`<div class="card" style="border-left:5px solid #ff6f00"><b>🍛 ${x.n}</b><br>📍 ${x.l} | Qty: ${x.q}<br>📞 ${x.d}<br><small>${x.t}</small><br><button class="green" onclick="alert('Call: ${x.d}')">Claim - Contact</button></div>`});document.getElementById('list').innerHTML=h}function addFood(){let n=a.value.trim(),l=b.value.trim(),q=c.value.trim(),d=d.value.trim?document.getElementById('d').value.trim():'';let msg=document.getElementById('m');let contact=document.getElementById('d').value.trim();if(!n||!l){msg.style.color='red';msg.innerText='Dish & Location compulsory baa!';alert('Dish Name & Location pettali');return}f.unshift({n:n,l:l,q:q||'1 plate',d:contact||'No contact',t:new Date().toLocaleString()});localStorage.setItem('anna',JSON.stringify(f));msg.style.color='green';msg.innerText='✅ Added! Total: '+f.length+' dishes';a.value='';b.value='';c.value='';document.getElementById('d').value='';show()}show();</script></body></html>
